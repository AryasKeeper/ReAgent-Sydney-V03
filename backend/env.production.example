# Production environment configuration  
# CRITICAL: These settings are HARD-LOCKED for production environment

# Environment (REQUIRED)
ENVIRONMENT=production

# Security settings (HARD-LOCKED - cannot be overridden)
# DEBUG=False (hard-locked in code)
# REQUIRE_API_KEY=True (hard-locked in code)
# USE_MOCK=False (hard-locked in code)

# Required API keys for production (ALL REQUIRED)
API_KEY=your_production_api_key_here
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters_long_for_security
ADMIN_API_KEY=your_admin_key_for_production_access

# Database (REQUIRED - must not contain default passwords)
DATABASE_URL=postgresql://prod_user:secure_complex_password@prod-db-host:5432/reagent_production

# AI Provider Keys (at least one required)
OPENAI_API_KEY=sk-your-production-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-production-anthropic-key-here

# External services (recommended for production)
TAVILY_API_KEY=tvly-your-production-tavily-key
FIRECRAWL_API_KEY=fc-your-production-firecrawl-key
BRAVE_API_KEY=your-production-brave-search-key

# Service configuration
BACKEND_URL=https://api.reagent.properties
SESSION_TIMEOUT_MINUTES=30
MAX_REQUESTS_PER_MINUTE=60

# Redis (recommended for production)
REDIS_URL=redis://prod-redis:6379
USE_REDIS_SESSIONS=true

# Production optimizations
CLASSIFICATION_LOG_RATE_LIMIT=100
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_MODEL_COMPLEX=gpt-4o

# Regional deployment
BACKEND_REGION=ap-southeast-2
# Staging environment configuration
# CRITICAL: These settings are HARD-LOCKED for staging environment

# Environment (REQUIRED)
ENVIRONMENT=staging

# Security settings (HARD-LOCKED - cannot be overridden)
# DEBUG=False (hard-locked in code)
# REQUIRE_API_KEY=True (hard-locked in code)  
# USE_MOCK=False (hard-locked in code)

# Required API keys for staging
API_KEY=your_staging_api_key_here
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters_long_for_security

# Database (REQUIRED for staging)
DATABASE_URL=postgresql://username:secure_password@staging-db-host:5432/reagent_staging

# AI Provider Keys (at least one required)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Optional admin access
ADMIN_API_KEY=your_admin_key_for_staging_diagnostics

# External services (optional)
TAVILY_API_KEY=tvly-your-tavily-key
FIRECRAWL_API_KEY=fc-your-firecrawl-key
BRAVE_API_KEY=your-brave-search-key

# Service configuration
BACKEND_URL=https://your-staging-backend.com
SESSION_TIMEOUT_MINUTES=30
MAX_REQUESTS_PER_MINUTE=120

# Redis (optional)
REDIS_URL=redis://staging-redis:6379
USE_REDIS_SESSIONS=true

# Additional staging-specific settings
CLASSIFICATION_LOG_RATE_LIMIT=200
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=medium
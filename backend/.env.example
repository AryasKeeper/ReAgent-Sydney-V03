# ReAgent Sydney V3 - Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI Configuration (for GPT-4)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Configuration (for Claude 3.5)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Tavily Configuration (for web search)
TAVILY_API_KEY=tvly-your-tavily-key-here

# Perplexity Configuration (optional, for additional web search)
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here

# Firecrawl Configuration (for property data scraping)
FIRECRAWL_API_KEY=fc-your-firecrawl-key-here

# Application Settings
DEBUG=true
USE_MOCK=false  # Set to false to use real AI models

# Backend URL
BACKEND_URL=http://localhost:8000
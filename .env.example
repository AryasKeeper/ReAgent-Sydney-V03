# ReAgent Sydney V3 - Environment Configuration Template
# Copy this file to .env.local for local development
# Configure production values in Vercel Dashboard

# ============================================
# AI Provider Configuration
# ============================================
# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_USE_RESPONSES=true
OPENAI_REASONING_EFFORT=medium
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# Backend Configuration
# ============================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000

# ============================================
# Search & Browsing APIs
# ============================================
BRAVE_API_KEY=...
FIRECRAWL_API_KEY=...
TAVILY_API_KEY=...
BROWSERLESS_TOKEN=...

# ============================================
# Feature Flags (Progressive Migration)
# ============================================
# AI SDK v5 Migration (default: false during migration)
NEXT_PUBLIC_AI_SDK_V5_ENABLED=false

# UI Message Stream Protocol (default: false during migration)
NEXT_PUBLIC_UI_MESSAGE_STREAM_ENABLED=false

# AI Elements Components (default: false during migration)
NEXT_PUBLIC_AI_ELEMENTS_ENABLED=false

# ============================================
# Performance & Region Configuration
# ============================================
# Sydney Region Optimization
NEXT_PUBLIC_REGION=sydney
VERCEL_REGION=syd1

# ============================================
# Development Settings
# ============================================
DEBUG=false
USE_MOCK=false
REQUIRE_API_KEY=false

# ============================================
# Redis Configuration (Optional)
# ============================================
USE_REDIS_SESSIONS=false
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# Monitoring & Analytics (Future)
# ============================================
# VERCEL_ANALYTICS_ID=...
# OTEL_EXPORTER_OTLP_ENDPOINT=...